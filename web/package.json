{
  "name": "kv-file-web",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run docs:build && mkdir -p dist/docs && cp -r ../docs/public/* dist/docs/",
    "build:pro": "tsc && VITE_APP_EDITION=pro vite build && (if [ -d ../docs/public ]; then mkdir -p dist/docs && cp -r ../docs/public/* dist/docs/; fi)",
    "build:community": "tsc && VITE_APP_EDITION=community vite build && (if [ -d ../docs/public ]; then mkdir -p dist/docs && cp -r ../docs/public/* dist/docs/; fi)",
    "preview": "vite preview",
    "docs:dev": "hugo server -D --source ../docs",
    "docs:build": "hugo --minify --source ../docs"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.10",
    "@types/jszip": "^3.4.0",
    "@types/prismjs": "^1.26.6",
    "@xyflow/react": "^12.11.6",
    "ag-psd": "^31.0.2",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dxf-parser": "^1.1.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "pako": "^3.0.2",
    "pdfjs-dist": "^6.3.289",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
