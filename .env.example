# ==============================================================================
# KV Files PRO - Configuration & Official ZaloPay Integration (v2)
# ==============================================================================

# Server Settings
KV_HOST=0.0.0.0
KV_PORT=8866
KV_DATA_DIR=./data
KV_STORAGE_ROOTS=./storage
RUST_LOG=kv_files=info,tower_http=info

# ------------------------------------------------------------------------------
# ZaloPay Payment Environment ("sandbox" or "production")
# ------------------------------------------------------------------------------
ZALOPAY_ENV=production

# ------------------------------------------------------------------------------
# ZaloPay Production Merchant & VietQR Details
# ------------------------------------------------------------------------------
ZALOPAY_APP_ID=210841
ZALOPAY_STORE_ID=835219_835220_835221
ZALOPAY_MERCHANT_NAME=KV FILE PRO (Thu Ngân)
ZALOPAY_MERCHANT_CODE=ZP-9B856443
ZALOPAY_BANK_NAME=BVBank (Ngân hàng Bản Việt)
ZALOPAY_BANK_BIN=970454
ZALOPAY_ACCOUNT_NO=99ZP26264M77756812
ZALOPAY_QR_IMAGE=/zalopay_pro_qr.png

# ZaloPay Open API Gateway Endpoints
ZALOPAY_CREATE_ENDPOINT=https://openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_ENDPOINT=https://openapi.zalopay.vn/v2/query

# Callbacks & Merchant Identity
ZALOPAY_REDIRECT_URL=http://localhost:8866/settings?tab=extensions
ZALOPAY_CALLBACK_URL=http://localhost:8866/api/v1/payments/zalopay/callback

# (Optional: If provided with Open API Key1/Key2 by ZaloPay Merchant Portal)
# ZALOPAY_KEY1=your_production_key1
# ZALOPAY_KEY2=your_production_key2
